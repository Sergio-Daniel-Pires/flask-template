# Copy this file to .env (create_project.py does it for you).
# Never commit .env.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me
# FLASK_DEBUG=1

# Gunicorn (Linux and Docker only; gunicorn does not run on Windows)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=sync
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
