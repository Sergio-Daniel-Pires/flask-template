# Copy this file to .env (create_project.py does it for you).
# Never commit .env.

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me
# FLASK_DEBUG=1
# demo (default), preview, or test. The preview/E2E scripts set this.
# APP_PROFILE=demo

# Database (default: SQLite at instance/app.db)
# Relative SQLite paths are resolved inside Flask's instance/ directory.
# DATABASE_URL=sqlite:///app.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app

# Gunicorn (Linux and Docker only; gunicorn does not run on Windows)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=sync
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
